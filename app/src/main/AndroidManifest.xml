<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/TilPadTheme">

        <!--
          设置入口 Activity — 让 App 在桌面有图标。
          用户点桌面图标后打开此页面，可以跳转到系统输入法设置。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          输入法服务声明。
          - android:permission="android.permission.BIND_INPUT_METHOD" 是系统要求的权限，
            只有系统 InputMethodManager 可以绑定此 Service。
          - intent-filter 的 action 必须为 android.view.InputMethod。
          - meta-data 指向 method.xml，定义输入法支持的 subtype（语言/模式）。
        -->
        <service
            android:name=".NurInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>
