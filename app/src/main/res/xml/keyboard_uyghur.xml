<?xml version="1.0" encoding="utf-8"?>
<!--
  维语键盘布局 — 参考截图一比一摆放。
  只放维文阿拉伯字母，不设数字行。
  123 键在左下角，点击切换到数字符号页面。

  Row 1: پ چ ې ر ت ي ئۇ ئى ئو ۆ
  Row 2: ا س د ف گ ھ ج ك ل خ
  Row 3: [⇧] ز ش غ ۋ ب ن م ق ژ [⌫]
  Row 4: [123] [🌐] [space] [↵]
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="45dp"
    android:horizontalGap="3dp"
    android:verticalGap="5dp">

    <!-- Row 1: پ چ ې ر ت ي ئۇ ئى ئو ۆ -->
    <Row android:rowEdgeFlags="top">
        <Key android:codes="0" android:keyLabel="پ"  android:keyOutputText="پ"  android:keyEdgeFlags="left" />
        <Key android:codes="0" android:keyLabel="چ"  android:keyOutputText="چ" />
        <Key android:codes="0" android:keyLabel="ې"  android:keyOutputText="ې" />
        <Key android:codes="0" android:keyLabel="ر"  android:keyOutputText="ر" />
        <Key android:codes="0" android:keyLabel="ت"  android:keyOutputText="ت" />
        <Key android:codes="0" android:keyLabel="ي"  android:keyOutputText="ي" />
        <Key android:codes="0" android:keyLabel="ئۇ" android:keyOutputText="ئۇ" />
        <Key android:codes="0" android:keyLabel="ئى" android:keyOutputText="ئى" />
        <Key android:codes="0" android:keyLabel="ئو" android:keyOutputText="ئو" />
        <Key android:codes="0" android:keyLabel="ۆ"  android:keyOutputText="ۆ"  android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 2: ا س د ف گ ھ ج ك ل خ -->
    <Row>
        <Key android:codes="0" android:keyLabel="ا" android:keyOutputText="ا" android:keyEdgeFlags="left" />
        <Key android:codes="0" android:keyLabel="س" android:keyOutputText="س" />
        <Key android:codes="0" android:keyLabel="د" android:keyOutputText="د" />
        <Key android:codes="0" android:keyLabel="ف" android:keyOutputText="ف" />
        <Key android:codes="0" android:keyLabel="گ" android:keyOutputText="گ" />
        <Key android:codes="0" android:keyLabel="ھ" android:keyOutputText="ھ" />
        <Key android:codes="0" android:keyLabel="ج" android:keyOutputText="ج" />
        <Key android:codes="0" android:keyLabel="ك" android:keyOutputText="ك" />
        <Key android:codes="0" android:keyLabel="ل" android:keyOutputText="ل" />
        <Key android:codes="0" android:keyLabel="خ" android:keyOutputText="خ" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 3: [⇧] ز ش غ ۋ ب ن م ق ژ [⌫] -->
    <Row>
        <Key android:codes="-1"  android:keyLabel="⇧" android:keyWidth="13%p"
             android:isModifier="true" android:keyEdgeFlags="left" />
        <Key android:codes="0" android:keyLabel="ز"  android:keyOutputText="ز"  android:keyWidth="8.5%p" />
        <Key android:codes="0" android:keyLabel="ش"  android:keyOutputText="ش"  android:keyWidth="8.5%p" />
        <Key android:codes="0" android:keyLabel="غ"  android:keyOutputText="غ"  android:keyWidth="8.5%p" />
        <Key android:codes="0" android:keyLabel="ۋ"  android:keyOutputText="ۋ"  android:keyWidth="8.5%p" />
        <Key android:codes="0" android:keyLabel="ب"  android:keyOutputText="ب"  android:keyWidth="8.5%p" />
        <Key android:codes="0" android:keyLabel="ن"  android:keyOutputText="ن"  android:keyWidth="8.5%p" />
        <Key android:codes="0" android:keyLabel="م"  android:keyOutputText="م"  android:keyWidth="8.5%p" />
        <Key android:codes="0" android:keyLabel="ق"  android:keyOutputText="ق"  android:keyWidth="8.5%p" />
        <Key android:codes="0" android:keyLabel="ژ"  android:keyOutputText="ژ"  android:keyWidth="8.5%p" />
        <Key android:codes="-5"  android:keyLabel="⌫" android:keyWidth="13%p"
             android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 4: [123] [🌐] [space] [↵] -->
    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-103" android:keyLabel="123" android:keyWidth="15%p"
             android:keyEdgeFlags="left" />
        <Key android:codes="-101" android:keyLabel="🌐"  android:keyWidth="15%p" />
        <Key android:codes="32"   android:keyLabel="ئۇيغۇرچە" android:keyWidth="40%p" />
        <Key android:codes="-4"   android:keyLabel="↵"  android:keyWidth="15%p"
             android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

</Keyboard>
