        <Key android:codes="0" android:keyLabel="خ" android:keyOutputText="خ" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 3: [⇧] ز ش غ ۋ ب ن م ق ژ [⌫] -->
    <Row>
        <Key android:codes="-102" android:keyLabel="⌫" android:keyWidth="14%p"
             android:isRepeatable="true" android:keyEdgeFlags="left" />
        <Key android:codes="0" android:keyLabel="ز" android:keyOutputText="ز" android:keyWidth="8.4%p" />
        <Key android:codes="0" android:keyLabel="ش" android:keyOutputText="ش" android:keyWidth="8.4%p" />
