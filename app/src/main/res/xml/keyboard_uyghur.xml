        <Key android:codes="32" android:keyLabel="ئۇيغۇرچە" android:keyWidth="30%p" />
        <Key android:codes="0" android:keyLabel="ە" android:keyOutputText="ە" android:keyWidth="8.4%p" />
        <Key android:codes="0" android:keyLabel="ى" android:keyOutputText="ى" android:keyWidth="8.4%p" />
        <Key android:codes="0" android:keyLabel="و" android:keyOutputText="و" android:keyWidth="8.4%p" />
        <Key android:codes="-4"  android:keyLabel="↵" android:keyWidth="14%p"
             android:keyEdgeFlags="right" />
    </Row>

</Keyboard>
