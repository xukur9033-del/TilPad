<?xml version="1.0" encoding="utf-8"?>
<!--
  中文键盘布局 — 现代风格，拼音 26 键 + 数字行。
  参考微信/搜狗输入法风格。
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="48dp"
    android:horizontalGap="4dp"
    android:verticalGap="6dp">

    <!-- Row 0: 数字行 -->
    <Row android:rowEdgeFlags="top">
        <Key android:codes="49" android:keyLabel="1" android:keyEdgeFlags="left" />
        <Key android:codes="50" android:keyLabel="2" />
        <Key android:codes="51" android:keyLabel="3" />
        <Key android:codes="52" android:keyLabel="4" />
        <Key android:codes="53" android:keyLabel="5" />
        <Key android:codes="54" android:keyLabel="6" />
        <Key android:codes="55" android:keyLabel="7" />
        <Key android:codes="56" android:keyLabel="8" />
        <Key android:codes="57" android:keyLabel="9" />
        <Key android:codes="48" android:keyLabel="0" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 1: q w e r t y u i o p -->
    <Row>
        <Key android:codes="113" android:keyLabel="q" android:keyEdgeFlags="left" />
        <Key android:codes="119" android:keyLabel="w" />
        <Key android:codes="101" android:keyLabel="e" />
        <Key android:codes="114" android:keyLabel="r" />
        <Key android:codes="116" android:keyLabel="t" />
        <Key android:codes="121" android:keyLabel="y" />
        <Key android:codes="117" android:keyLabel="u" />
        <Key android:codes="105" android:keyLabel="i" />
        <Key android:codes="111" android:keyLabel="o" />
        <Key android:codes="112" android:keyLabel="p" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 2: a s d f g h j k l -->
    <Row>
        <Key android:codes="97"  android:keyLabel="a" android:keyEdgeFlags="left" />
        <Key android:codes="115" android:keyLabel="s" />
        <Key android:codes="100" android:keyLabel="d" />
        <Key android:codes="102" android:keyLabel="f" />
        <Key android:codes="103" android:keyLabel="g" />
        <Key android:codes="104" android:keyLabel="h" />
        <Key android:codes="106" android:keyLabel="j" />
        <Key android:codes="107" android:keyLabel="k" />
        <Key android:codes="108" android:keyLabel="l" />
        <Key android:codes="39"  android:keyLabel="'" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 3: [⇧] z x c v b n m [⌫] -->
    <Row>
        <Key android:codes="-1"  android:keyLabel="⇧" android:keyWidth="14%p"
             android:isModifier="true" android:keyEdgeFlags="left" />
        <Key android:codes="122" android:keyLabel="z" android:keyWidth="8.4%p" />
        <Key android:codes="120" android:keyLabel="x" android:keyWidth="8.4%p" />
        <Key android:codes="99"  android:keyLabel="c" android:keyWidth="8.4%p" />
        <Key android:codes="118" android:keyLabel="v" android:keyWidth="8.4%p" />
        <Key android:codes="98"  android:keyLabel="b" android:keyWidth="8.4%p" />
        <Key android:codes="110" android:keyLabel="n" android:keyWidth="8.4%p" />
        <Key android:codes="109" android:keyLabel="m" android:keyWidth="8.4%p" />
        <Key android:codes="-5"  android:keyLabel="⌫" android:keyWidth="18.4%p"
             android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <!-- Row 4: [🌐] [123] [space] [↵] -->
    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-101" android:keyLabel="🌐" android:keyWidth="15%p"
             android:keyEdgeFlags="left" />
        <Key android:codes="-102" android:keyLabel="符" android:keyWidth="15%p" />
        <Key android:codes="32" android:keyLabel="中文" android:keyWidth="40%p" />
        <Key android:codes="-4"  android:keyLabel="↵" android:keyWidth="15%p"
             android:keyEdgeFlags="right" />
    </Row>

</Keyboard>
