<?xml version="1.0" encoding="utf-8"?>
<!--
  TilPad 输入法容器布局 v6 — 百度输入法同款样式
  顶部工具栏 + 候选栏 + 键盘/面板(互斥)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#d1d5db"
    android:layout_alignParentBottom="true">

    <!-- ====== 顶部工具栏 — 百度同款 #e5e7eb ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="#e5e7eb"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- 键盘图标 — 圆形白色按钮 -->
        <ImageView
            android:id="@+id/btn_layout"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:clickable="true"
            android:background="@drawable/bdf_tool_btn"
            android:contentDescription="Layout" />

        <!-- 表情图标 — 圆形白色按钮 -->
        <ImageView
            android:id="@+id/btn_emoji"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_smiley_face"
            android:scaleType="centerInside"
            android:padding="2dp"
            android:clickable="true"
            android:background="@drawable/bdf_tool_btn"
            android:layout_marginStart="14dp"
            android:contentDescription="Emoji" />

        <!-- 小齿轮图标 -->
        <ImageView
            android:id="@+id/btn_settings_gear"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:scaleType="centerInside"
            android:padding="5dp"
            android:clickable="true"
            android:background="@drawable/bdf_tool_btn"
            android:layout_marginStart="14dp"
            android:contentDescription="QuickToolbar" />

        <!-- 收起键盘箭头 -->
        <ImageView
            android:id="@+id/btn_collapse"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/arrow_down_float"
            android:scaleType="centerInside"
            android:padding="4dp"
            android:clickable="true"
            android:background="@drawable/bdf_tool_btn"
            android:layout_marginStart="14dp"
            android:contentDescription="Collapse" />

        <!-- 弹性间距 -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 语言切换按钮 -->
        <TextView
            android:id="@+id/btn_lang_english"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="En"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#888888"
            android:background="@drawable/lang_btn_inactive"
            android:layout_marginEnd="4dp"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_lang_chinese"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="中"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#888888"
            android:background="@drawable/lang_btn_inactive"
            android:layout_marginEnd="4dp"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_lang_uyghur"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="ئۇ"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FFFFFF"
            android:background="@drawable/lang_btn_active"
            android:clickable="true" />

    </LinearLayout>

    <!-- ====== 剪贴板粘贴提示条 — 百度同款 ====== -->
    <LinearLayout
        android:id="@+id/clipboard_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/clipboard_preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#666666"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/btn_paste"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="粘贴"
            android:textSize="13sp"
            android:textColor="#2a7aff"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bdf_tool_btn"
            android:clickable="true" />

        <TextView
            android:id="@+id/btn_clipboard_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="×"
            android:textSize="18sp"
            android:textColor="#999999"
            android:gravity="center"
            android:clickable="true"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- ====== 候选词栏 — 百度同款 #f9f9f9 ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#f9f9f9">

        <!-- 拼音显示行 — 百度同款蓝色 #2a7aff -->
        <TextView
            android:id="@+id/pinyin_label"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:textSize="14sp"
            android:textColor="#2a7aff"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone" />

        <!-- 候选词横排 + 关闭按钮 — 百度同款 42dp 高 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <HorizontalScrollView
                android:id="@+id/candidate_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:fillViewport="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/candidate_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

            </HorizontalScrollView>

            <!-- 百度同款：候选栏关闭按钮 × -->
            <TextView
                android:id="@+id/btn_candidate_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="×"
                android:textSize="22sp"
                android:textColor="#999999"
                android:gravity="center"
                android:clickable="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- ====== 自绘键盘 — 百度同款 #d1d5db ====== -->
    <com.tilpad.ime.TilPadKeyboardView
        android:id="@+id/tilpad_keyboard"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#d1d5db" />

    <!-- ====== 面板容器区域 ====== -->
    <FrameLayout
        android:id="@+id/panel_container"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#FFFFFF"
        android:visibility="gone" />

</LinearLayout>
