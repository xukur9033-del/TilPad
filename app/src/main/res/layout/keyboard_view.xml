<?xml version="1.0" encoding="utf-8"?>
<!--
  输入法键盘视图布局 — 与 input_view_container.xml 中的键盘属性保持一致。
-->
<com.tilpad.ime.NurKeyboardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:background="#E8EAED"
    android:keyBackground="@drawable/key_background"
    android:keyTextColor="#333333"
    android:keyTextSize="22sp"
    android:labelTextSize="14sp"
    android:keyPreviewLayout="@layout/key_preview"
    android:keyPreviewOffset="2dp"
    android:verticalGap="5dp"
    android:horizontalGap="0.5dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:shadowRadius="0.0" />
