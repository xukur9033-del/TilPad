<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Telegram 风格主题 -->
    <style name="TilPadTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/telegram_blue_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/telegram_blue</item>
        <item name="colorPrimaryDark">@color/telegram_blue_dark</item>
        <item name="colorAccent">@color/telegram_blue</item>
        <item name="android:windowBackground">@color/bg_main</item>
    </style>

    <!-- 设置项文字样式 -->
    <style name="SettingItemTitle" parent="android:Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SettingItemSubtitle" parent="android:Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SectionTitle" parent="android:Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

</resources>
